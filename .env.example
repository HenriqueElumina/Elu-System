# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Project Settings -> API). Nunca commite o .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional por enquanto: só necessário para ações administrativas
# (ex.: convidar usuário) que ainda não existem nesta etapa.
SUPABASE_SERVICE_ROLE_KEY=

# ZapSign (Configurações > Integrações > ZAPSIGN API no painel deles).
ZAPSIGN_API_TOKEN=
ZAPSIGN_API_BASE_URL=https://api.zapsign.com.br
# Valor secreto que você escolhe -- vai na própria URL do webhook
# cadastrada no painel do ZapSign (/api/webhooks/zapsign/<este-valor>),
# pra o sistema confirmar que a notificação é legítima. Gere um valor
# aleatório (ex.: `openssl rand -hex 32`).
ZAPSIGN_WEBHOOK_SECRET=

# Etapa 1.7 (Financeiro): valor secreto que a Vercel manda automaticamente
# no cabeçalho Authorization quando dispara o Cron Job -- confirma que a
# chamada em /api/cron/gerar-faturas é da Vercel, não de qualquer um.
# Configurar em Project Settings -> Environment Variables na Vercel.
CRON_SECRET=

# Etapa 1.8 (Financeiro): URL pública de produção do sistema -- usada pra
# montar a notification_url que a gente manda pra Efí ao criar um boleto
# (ex.: https://elu-system.vercel.app).
APP_BASE_URL=

# Efí (boleto). client_id/client_secret e certificado vêm do painel da
# Efí (ambiente de homologação primeiro, depois produção) -- Configurações
# > API. O certificado (.p12) precisa virar base64
# (`base64 -i certificado.p12`) pra caber numa variável de ambiente.
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_BASE64=
# Só se o certificado tiver senha -- a maioria não tem.
EFI_CERTIFICATE_PASSPHRASE=
# "true" (padrão, mais seguro) usa o ambiente de homologação;
# "false" usa produção.
EFI_SANDBOX=true
# Mesmo espírito do ZAPSIGN_WEBHOOK_SECRET -- valor aleatório que você
# escolhe, vai na URL do webhook (/api/webhooks/efi/<este-valor>).
EFI_WEBHOOK_SECRET=
