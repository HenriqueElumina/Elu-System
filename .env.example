# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Project Settings -> API). Nunca commite o .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional por enquanto: só necessário para ações administrativas
# (ex.: convidar usuário) que ainda não existem nesta etapa.
SUPABASE_SERVICE_ROLE_KEY=

# ZapSign (Configurações > Integrações > ZAPSIGN API no painel deles).
ZAPSIGN_API_TOKEN=
ZAPSIGN_API_BASE_URL=https://api.zapsign.com.br
# Valor secreto que você escolhe -- vai num cabeçalho customizado do
# webhook no painel do ZapSign, pra o sistema confirmar que a notificação
# é legítima. Gere um valor aleatório (ex.: `openssl rand -hex 32`).
ZAPSIGN_WEBHOOK_SECRET=
